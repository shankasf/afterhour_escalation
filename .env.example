# ===========================================
# After-Hours Escalation System Configuration
# ===========================================

# Database
# If using docker-compose, Postgres is exposed on localhost:5434 by default.
DATABASE_URL="postgresql://postgres:escalation_password@localhost:5434/escalation"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="24h"

# Service URLs
BACKEND_URL="http://localhost:3004"
AI_SERVICE_URL="http://localhost:8083"
FRONTEND_URL="http://localhost:5175"

# OpenAI Configuration
OPENAI_API_KEY="sk-your-openai-api-key"
# Note: the AI service enforces gpt-5.2 in code.
OPENAI_MODEL="gpt-5.2"
# Reserved for future audio generation (currently Twilio TTS is used)
OPENAI_VOICE_MODEL="gpt-realtime-2025-08-28"

# Twilio Configuration
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WEBHOOK_URL="https://your-domain.com/twilio"

# Dialpad Configuration
DIALPAD_API_KEY="your-dialpad-api-key"
DIALPAD_WEBHOOK_SECRET="your-dialpad-webhook-secret"

# Gmail Email Configuration
# IMAP Settings (for receiving emails)
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="your-email@gmail.com"
IMAP_PASSWORD="your-gmail-app-password"
IMAP_ENCRYPTION="SSL"

# SMTP Settings (for sending emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
SMTP_ENCRYPTION="STARTTLS"

# Email Settings
EMAIL_FROM_ADDRESS="your-email@gmail.com"
EMAIL_FROM_NAME="After-Hours Escalation System"
ADMIN_EMAIL="admin@yourdomain.com"

# Escalation Configuration
# Emergency score is 0.0-1.0 in the AI service.
EMERGENCY_SCORE_THRESHOLD=0.6
ACKNOWLEDGMENT_TIMEOUT_SECONDS=120
ESCALATION_WINDOW_START="00:00"
ESCALATION_WINDOW_END="07:00"
TIMEZONE="America/New_York"

# Data Retention
DATA_RETENTION_DAYS=90

# Redis (for job queue)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Node Environment
NODE_ENV="development"
