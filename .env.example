# ===========================================
# After-Hours Escalation System Configuration
# ===========================================
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://postgres:your-db-password@localhost:5434/escalation"

# JWT Authentication
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRATION="24h"

# Service URLs
BACKEND_URL="http://localhost:3004"
AI_SERVICE_URL="http://localhost:8083"
FRONTEND_URL="http://localhost:5175"

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_VOICE_MODEL=""

# LangSmith Observability & Evaluation
LANGSMITH_TRACING=true
LANGSMITH_PROJECT="after-hours-agent"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_SERVICE_KEY=""
LANGSMITH_PERSONAL_API_KEY=""

# Twilio Configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WEBHOOK_URL=""

# Dialpad Configuration
DIALPAD_API_KEY=""
DIALPAD_WEBHOOK_SECRET=""

# Gmail Email Configuration
# IMAP Settings (for receiving emails)
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_ENCRYPTION="SSL"

# SMTP Settings (for sending emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="STARTTLS"

# Email Settings
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="After-Hours Escalation System"
ADMIN_EMAIL=""

# Escalation Configuration
EMERGENCY_SCORE_THRESHOLD=0.6
ACKNOWLEDGMENT_TIMEOUT_SECONDS=120
ESCALATION_WINDOW_START="00:00"
ESCALATION_WINDOW_END="07:00"
TIMEZONE="America/New_York"

# Data Retention
DATA_RETENTION_DAYS=90

# Redis (for job queue)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Node Environment
NODE_ENV="development"
